rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPsychologist(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPsychologistResource() {
      return signedIn() && resource.data.psychologistId == request.auth.uid;
    }

    function isPsychologistRequest() {
      return signedIn() && request.resource.data.psychologistId == request.auth.uid;
    }

    match /psychologists/{uid}/state/{document} {
      allow read, write: if isPsychologist(uid);
    }

    match /pairingCodes/{code} {
      allow create: if isPsychologistRequest();
      allow read: if signedIn();
      allow update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         request.resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /homework/{id} {
      allow create: if isPsychologistRequest();
      allow read: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /formAssignments/{id} {
      allow create: if isPsychologistRequest();
      allow read, update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /appointments/{id} {
      allow create: if signedIn();
      allow read, update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
    }

    match /psychologists/{uid}/availability/{slot} {
      allow read: if signedIn();
      allow write: if isPsychologist(uid);
    }

    match /users/{uid} {
      allow read, write: if isPsychologist(uid);
    }
  }
}

// Firebase Spark plan için Cloud Functions veya ücretli bildirim servisi kullanılmaz.
// Uygulama içi bildirimler Firestore kayıtları ve gerçek zamanlı dinleyicilerle sağlanır.
