rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPsychologist(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isPsychologistResource() {
      return signedIn() && resource.data.psychologistId == request.auth.uid;
    }

    function isPsychologistRequest() {
      return signedIn() && request.resource.data.psychologistId == request.auth.uid;
    }

    match /psychologists/{uid}/state/{document} {
      allow read, write: if isPsychologist(uid);
    }

    match /patients/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (resource.data.psychologistId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diagnosisCodes']))
      );
    }

    match /psychologists/{uid}/appointments/{id} {
      allow read: if isPsychologist(uid) ||
        (signedIn() && resource.data.clientFirebaseUid == request.auth.uid);
      allow create: if isPsychologist(uid) ||
        (signedIn() && request.resource.data.clientFirebaseUid == request.auth.uid);
      allow update: if isPsychologist(uid) ||
        (signedIn() && resource.data.clientFirebaseUid == request.auth.uid &&
         request.resource.data.clientFirebaseUid == request.auth.uid &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'status',
           'cancelledBy',
           'updatedAt'
         ]));
      allow delete: if isPsychologist(uid) ||
        (signedIn() && resource.data.clientFirebaseUid == request.auth.uid);
    }

    match /psychologists/{uid}/tasks/{taskId} {
      allow read: if isPsychologist(uid) ||
        (signedIn() && resource.data.clientFirebaseUid == request.auth.uid);
      allow create, delete: if isPsychologist(uid);
      allow update: if isPsychologist(uid) ||
        (signedIn() && resource.data.clientFirebaseUid == request.auth.uid);
    }

    match /pairingCodes/{code} {
      allow create: if isPsychologistRequest();
      allow read: if signedIn();
      allow update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         request.resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /homework/{id} {
      allow create: if isPsychologistRequest();
      allow read: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /formAssignments/{id} {
      allow create: if isPsychologistRequest();
      allow read, update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if isPsychologistResource();
    }

    match /appointments/{id} {
      allow create: if signedIn();
      allow read, update: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
      allow delete: if signedIn() &&
        (resource.data.psychologistId == request.auth.uid ||
         resource.data.clientUserId == request.auth.uid);
    }

    match /psychologists/{uid}/availability/{slot} {
      allow read: if signedIn();
      allow write: if isPsychologist(uid);
    }

    match /users/{uid} {
      allow read, write: if isPsychologist(uid);
    }
  }
}

// Firebase Spark plan için Cloud Functions veya ücretli bildirim servisi kullanılmaz.
// Uygulama içi bildirimler Firestore kayıtları ve gerçek zamanlı dinleyicilerle sağlanır.
